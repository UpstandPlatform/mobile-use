# Copy this template to a private env file. Replace the example hosts and values.
MOBILE_USE_IMAGE=ghcr.io/upstandplatform/mobile-use:v0.1.0
MOBILE_USE_BIND_IP=127.0.0.1
MOBILE_USE_ORIGIN=https://mobile-use.example.internal:8443
MOBILE_USE_OIDC_ISSUER=https://identity.example.internal/realms/mobile-use
MOBILE_USE_OIDC_AUDIENCE=https://mobile-use.example.internal:8443/mcp
MOBILE_USE_CONSOLE_CLIENT=mobile-use-console
MOBILE_USE_CONNECTORS=android-host-1=team
MOBILE_USE_TLS_DIRECTORY=/absolute/path/to/mobile-use-tls

# Use independent random values for the two passwords and the digest key.
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_PASSWORD=
MOBILE_USE_DIGEST_KEY=
# Insert the runtime password from POSTGRES_PASSWORD into the DSN below.
MOBILE_USE_POSTGRES=postgres://mobileuse:REPLACE_RUNTIME_PASSWORD@postgres:5432/mobileuse?sslmode=disable

# Optional TURN service for WebRTC on routed networks.
MOBILE_USE_TURN_URLS=
MOBILE_USE_TURN_SECRET=
MOBILE_USE_TURN_RELAY_ONLY=0
